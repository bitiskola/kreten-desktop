{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KRETEN Desktop",
  "version": "0.2.0",
  "identifier": "hu.kreten.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "KRETÉN Desktop",
      "width": 1360,
      "height": 900,
      "minWidth": 900,
      "minHeight": 640,
      "center": true,
      "backgroundColor": "#edf1f8"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "category": "Education",
    "shortDescription": "KRÉTA, kényelmesen az asztalodon.",
    "longDescription": "Local-first KRÉTA desktop client with encrypted local sessions, offline data, background refresh and native notifications.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": ["../THIRD_PARTY_NOTICES.md", "../docs/licenses/Firka.LICENSE.txt"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"],
        "desktopTemplate": "desktop.template"
      },
      "appimage": { "bundleMediaFramework": false }
    },
    "windows": {
      "nsis": { "displayLanguageSelector": false, "languages": ["Hungarian", "English"] }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowPosition": { "x": 400, "y": 400 },
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  }
}
